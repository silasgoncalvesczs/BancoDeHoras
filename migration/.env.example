# Copie para migration/.env e preencha. NUNCA commite o .env.

# --- Firebase ---------------------------------------------------------
# Console Firebase → Configurações do projeto → Contas de serviço → Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# Gerado com:  firebase auth:export users.json --format=json --project SEU_PROJECT_ID
FIREBASE_USERS_FILE=./users.json

# Console Firebase → Authentication → Usuários → menu ⋮ → "Parâmetros de hash de senha"
FIREBASE_HASH_SIGNER_KEY=
FIREBASE_HASH_SALT_SEPARATOR=
FIREBASE_HASH_ROUNDS=8
FIREBASE_HASH_MEM_COST=14

# Opcional: só se algum lançamento antigo usava Firebase Storage (campo imagePath)
FIREBASE_STORAGE_BUCKET=

# --- Supabase ---------------------------------------------------------
# Dashboard → Project Settings → API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Chave SECRETA (service_role). Só para este script local — nunca no site.
SUPABASE_SERVICE_ROLE_KEY=
